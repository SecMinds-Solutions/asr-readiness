# Copy to .env.local for local development. Values here are not secrets.

# Client ID of an Entra app registration to sign in with: multi-tenant, a single-page app with
# redirect URI http://localhost:5173/, and the delegated Microsoft Graph permissions openid,
# profile, email, User.Read, ThreatHunting.Read.All, DeviceManagementConfiguration.Read.All and
# DeviceManagementApps.Read.All.
# Leave empty to run the app without sign-in.
VITE_ENTRA_CLIENT_ID=

# Origins of the website and the app. The page compares its hostname with these to show the website
# or the app; the default *.azurestaticapps.net hostname shows the app. Locally (localhost) the website
# is at / and the app under /app, whatever these say. Only https origins without a path are used;
# empty or anything else falls back to the production origins below.
VITE_SITE_ORIGIN=https://asrcompass.cloud
VITE_APP_ORIGIN=https://app.asrcompass.cloud
